@model MovieStoreMvc.Models.DTO.MovieListVm
@{
    Layout = "_Layout";
}
<style>
    .search-bar {
        text-align: center;
        margin: 20px 0;
    }

        .search-bar input[type="text"] {
            padding: 8px;
            width: 250px;
            border-radius: 4px;
            border: 1px solid #ccc;
        }

        .search-bar button {
            padding: 8px 12px;
            background-color: #007bff;
            border: none;
            color: white;
            cursor: pointer;
            border-radius: 4px;
            margin-left: 5px;
        }

        .search-bar .btn-default {
            margin-left: 10px;
            text-decoration: none;
            padding: 8px 12px;
            background-color: #6c757d;
            color: white;
            border-radius: 4px;
        }

    .movies {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-around;
        padding: 20px;
        gap: 20px;
    }

    .movie-card {
        width: 22%;
        background-color: #f9f9f9;
        border: 1px solid #ddd;
        border-radius: 8px;
        overflow: hidden;
        cursor: pointer;
        transition: transform 0.2s;
        box-shadow: 0 2px 6px rgba(0,0,0,0.1);
    }

        .movie-card:hover {
            transform: scale(1.03);
        }

    .movie-image img {
        width: 100%;
        height: 300px;
        object-fit: cover;
        display: block;
    }

    .movie-info {
        padding: 10px;
        text-align: center;
    }

        .movie-info h4 {
            margin: 5px 0;
            font-size: 16px;
        }

    .pagination {
        text-align: center;
        margin: 30px 0;
    }

        .pagination a {
            padding: 8px 12px;
            margin: 0 5px;
            text-decoration: none;
            background-color: #f1f1f1;
            border-radius: 4px;
            color: #333;
            border: 1px solid #ccc;
        }

            .pagination a.active {
                background-color: #007bff;
                color: white;
                font-weight: bold;
                border-color: #007bff;
            }

    /* Responsive */
    @@media (max-width: 992px) {
        .movie-card

    {
        width: 45%;
    }

    }

    @@media (max-width: 600px) {
        .movie-card

    {
        width: 100%;
    }

    }</style>

<section class="search-bar">
    <form method="get" asp-action="Index">
        <input type="text" name="term" placeholder="search here">
        <button type="submit"><i class="fa fa-search"></i></button>
        <a class="btn btn-default" href="/Home/Index">All</a>
    </form>
</section>

<section class="movies">
    @foreach (var movie in Model.MovieList)
    {
        <div class="movie-card" onclick="window.location.href='/Home/MovieDetail?movieId=@movie.Id'">
            <div class="movie-image">
                <img src="/Uploads/@movie.MovieImage" alt="@movie.Title Poster">
            </div>
            <div class="movie-info">
                <h4>@movie.Title</h4>
                <h4>@movie.GenreNames</h4>
                <h4>@movie.ReleaseYear</h4>
            </div>
        </div>
    }
</section>

<div class="pagination">
    @for (int i = 1; i <= Model.TotalPages; i++)
    {
        if (i == Model.CurrentPage)
        {
            <a href="/Home/Index?currentPage=@i&term=@Model.Term" class="active">@i</a>
        }
        else
        {
            <a href="/Home/Index?currentPage=@i&term=@Model.Term">@i</a>
        }
    }
</div>
